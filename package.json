{
  "name": "openbot-lego",
  "version": "1.0.0",
  "description": "Interactive 3D LEGO Tropical House & real-time visual HQ for OpenBot Desktop AI agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "openbot-lego": "./dist-cli/cli.mjs"
  },
  "files": [
    "dist",
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openbot",
    "lego",
    "ai-agent",
    "3d",
    "threejs",
    "react-three-fiber",
    "cli",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RajaskaJanuardani/lego-openbot-agent.git"
  },
  "homepage": "https://github.com/RajaskaJanuardani/lego-openbot-agent#readme",
  "bugs": {
    "url": "https://github.com/RajaskaJanuardani/lego-openbot-agent/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "bridge": "tsx watch --exclude bridge/data/** bridge/server.ts",
    "simulate-agent": "tsx scripts/simulate-agent.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "three": "^0.169.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "zustand": "^5.1.0"
  }
}
